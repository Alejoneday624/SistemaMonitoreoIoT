# Copie este archivo a .env y ajuste los valores si es necesario.
# El archivo .env NO debe subirse a control de versiones (esta en .gitignore).

# ---------------------------------------------------------------
# Base de datos local (servicio `db` del docker-compose.yml)
# ---------------------------------------------------------------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=cambieme
POSTGRES_DB=campusiot

# ---------------------------------------------------------------
# Backend — solo si necesita sobrescribir los valores por defecto.
# En Docker el docker-compose.yml los inyecta solo.
# ---------------------------------------------------------------
# SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/campusiot
# SPRING_DATASOURCE_USERNAME=postgres
# SPRING_DATASOURCE_PASSWORD=cambieme

# ---------------------------------------------------------------
# Supabase (PostgreSQL gestionado en la nube)
# 1. En Supabase > Project Settings > Database copie el "Connection string".
# 2. Descomente las lineas siguientes y ajuste. El servicio `db` local
#    seguira levantandose, pero el backend usara Supabase.
# ---------------------------------------------------------------
# SPRING_DATASOURCE_URL=jdbc:postgresql://db.xxxxxxxxxxxxxx.supabase.co:5432/postgres
# SPRING_DATASOURCE_USERNAME=postgres
# SPRING_DATASOURCE_PASSWORD=<clave-del-proyecto-supabase>

# ---------------------------------------------------------------
# Opcionales (tienen valor por defecto en application.properties)
# ---------------------------------------------------------------
# SENSOR_FRECUENCIA_MS=5000
# HEARTBEAT_SEGUNDOS=120
# UMBRAL_PPM=900
